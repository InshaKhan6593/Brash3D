# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli
/output/playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local credential notes. The repository is public: plaintext passwords must
# never reach a commit, where history keeps them even after a later deletion.
/TEST_CREDENTIALS.md
*.credentials.md
/TESTSPRITE_PRD.md
testsprite_tests/
testsprite_tests/tmp/
testsprite_tests/tmp/config.json
