DATABASE_URL=postgresql://postgres:postgres@localhost:5440/brash3d
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. Defaults shown; every value below may be omitted.

# Invoice rates, as decimal fractions. A change applies only to sessions created
# afterwards; each session stores the rates it was priced with.
TAX_RATE_FL=0.07
FEE_RATE=0.15

# Complimentary bookings one referrer can earn per calendar month.
REFERRAL_REWARD_MONTHLY_CAP=3

# How long an unpaid booking holds its slot, in minutes (5-30).
STRIPE_BOOKING_HOLD_MINUTES=15

# How often the in-process maintenance job releases expired holds and prunes
# spent rows. Set to 0 on a serverless host, where timers never fire between
# requests, and drive POST /api/maintenance from the platform's cron instead.
MAINTENANCE_INTERVAL_MINUTES=5

# Bearer token POST /api/maintenance requires. Unset, that route stays closed
# and only the in-process timer runs. On Vercel, set CRON_SECRET to the same
# value so its scheduler is authorized.
# MAINTENANCE_SECRET=

# PostgreSQL connection pool size. Use 1 on a serverless host, where every
# concurrent instance opens its own pool.
DATABASE_POOL_MAX=10

# TLS for the database connection. Omitted, a localhost DATABASE_URL connects
# without TLS and any other host verifies against the system CA store, which is
# what a managed provider such as Supabase needs. Override with:
#   require   - force verification even for a local host
#   no-verify - encrypt without verifying, only if `require` fails on a
#               provider whose CA is not in the system store
#   disable   - no TLS
# DATABASE_SSL=require

# PEM contents (not a path) of a provider CA certificate, when the system store
# does not carry it. Preferred over DATABASE_SSL=no-verify.
# DATABASE_SSL_CA=

# --- Live cart updates over Supabase Realtime (optional) ---------------------
#
# All three must be set for the customer's order page to receive pushed
# updates. With any of them missing the page polls exactly as before, so a
# missing or rotated credential slows the page down rather than breaking it.
#
# The browser opens the socket to Supabase directly. That is deliberate: on a
# serverless host a function cannot hold a long-lived connection, so streaming
# from this app would pin one invocation per viewer.
#
# No NEXT_PUBLIC_ prefix on any of these, deliberately. The browser does need
# the URL and publishable key to open its socket, but it gets them from
# GET /api/realtime/token -- a response it only receives after proving it holds
# a customer access token for that session. A NEXT_PUBLIC_ prefix would instead
# inline them into the bundle of every page for every visitor, which buys
# nothing and is what Vercel warns about.
#
# They grant nothing on their own in any case: migration 018 leaves `anon` with
# no privileges at all, and the three readable tables are each behind an RLS
# policy keyed on a signed claim.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# Server-only, and a real secret: it signs the short-lived tokens that scope a
# subscription to one order. Never give this a NEXT_PUBLIC_ prefix.
#
# Supabase dashboard -> Settings -> JWT Keys -> Legacy JWT Secret -> Reveal.
# Projects migrated to JWT Signing Keys keep this secret for verification, so
# tokens signed with it are still accepted. Revoking it stops Realtime and the
# page falls back to polling -- no outage, but no push either.
# SUPABASE_JWT_SECRET=

# --- WhatsApp Cloud API (optional, not yet wired to any code) ----------------
#
# Specification section 7.1: echo each product into the customer's WhatsApp chat
# as the seller adds it during the live call. Unset, nothing is sent and the web
# cart behaves exactly as it does today -- the cart is the authoritative total
# either way, which is what the specification asks for.
#
# The rule that governs all of this: a business may only send free text to
# someone who has messaged it in the last 24 hours. A WhatsApp video call does
# NOT open that window -- Meta's calling exception covers voice calls placed or
# answered through the Business Calling API on the registered number, which is a
# different surface from the seller's own handset. So the customer opens the
# window themselves by tapping a wa.me link on their order page at the start of
# the session. See docs/WHATSAPP.md.

# The test number's, or later the client's, from the Meta app dashboard.
# WHATSAPP_PHONE_NUMBER_ID=

# A System User token from Business Settings, not the dashboard token: that one
# expires after 24 hours and will stop a test mid-afternoon.
# WHATSAPP_CLOUD_API_TOKEN=

# The business number in international format, digits only, no + or spaces
# (e.g. 15551234567). This is what the customer's wa.me link points at, so it
# must be the number registered to Cloud API -- a message to the seller's
# personal WhatsApp opens no window.
# WHATSAPP_BUSINESS_NUMBER=

# Graph API version the send calls target. Pinned rather than floating, so Meta
# deprecating a version is a deliberate bump here and not a surprise outage.
# WHATSAPP_API_VERSION=v23.0

# --- Inbound webhook (optional, needed only to know the window is open) ------
#
# Without these the app can still send; it simply cannot tell whether the
# customer has opened the chat, so the seller finds out only when a send is
# rejected. With them, the panel can say "the customer has not opened WhatsApp
# yet" while there is still time to ask them on the call.

# Any string you choose. Meta echoes it back during the GET verification
# handshake when you register the webhook, and the route rejects a mismatch.
# WHATSAPP_VERIFY_TOKEN=

# The app secret from the Meta dashboard, used to verify the X-Hub-Signature-256
# header on inbound events. Unset, the webhook cannot prove an event came from
# Meta, so it refuses every POST rather than trusting the body.
# WHATSAPP_APP_SECRET=

# --- Approved template names (optional) -------------------------------------
#
# Names differ per WhatsApp Business Account: a template created on a test
# account cannot be reused on the client's, so these are configuration rather
# than constants. Unset, only free text is attempted -- correct before any
# template has been approved.
#
# The language must match how the template was approved. Meta treats `es` and
# `es_ES` as different templates and fails a mismatch with an error naming
# neither.
# WHATSAPP_TEMPLATE_BOOKING=reserva_confirmada
# WHATSAPP_TEMPLATE_PRODUCT=producto_agregado
# WHATSAPP_TEMPLATE_LANGUAGE=es

# Language of the customer's WhatsApp messages: `es` (default, the shipping
# copy for Colombian buyers) or `en` for testing.
# WHATSAPP_MESSAGE_LOCALE=es

# The site's public origin, used for links inside messages. Without it a link
# is built from the request that triggered it -- which for a Stripe webhook
# delivered to a tunnel or to localhost yields a URL WhatsApp will not linkify,
# so the customer is sent a link they cannot tap.
# APP_URL=https://brash3-d.vercel.app
